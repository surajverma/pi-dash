{
  "name": "pi-dash",
  "version": "1.0.0",
  "private": true,
  "devDependencies": {
    "jsdom": "^26.1.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^3.3.0"
  },
  "scripts": {
    "capture:screenshots": "node scripts/capture-screenshots.cjs",
    "build:icons": "node scripts/export-icons.cjs",
    "build:css": "tailwindcss -c tailwind.config.js -i ./src/tailwind.css -o ./css/style.css --minify",
