{
  "base_path": "/",
  "refresh_interval": 2000,
  "queries_refresh_interval": 3000,
  "cache_ttl": 1000,
  "show_queries": false,
  "show_network_summary": true,
  "show_trends": true,
  "show_network_insights": false,
  "show_device_metrics": true,
  "piholes": [
    {
      "name": "Primary",
